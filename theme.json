{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        {
          "slug": "background",
          "color": "#2b2c2f",
          "name": "Background Dark"
        },
        {
          "slug": "surface",
          "color": "#1e1f21",
          "name": "Surface Card"
        },
        {
          "slug": "primary",
          "color": "#ffffff",
          "name": "Primary White"
        },
        {
          "slug": "secondary",
          "color": "#c9c9c9",
          "name": "Text Secondary"
        },
        {
          "slug": "tertiary",
          "color": "#454649",
          "name": "Border & Muted"
        },
        {
          "slug": "accent-cyan",
          "color": "#38bdf8",
          "name": "Accent Cyan"
        },
        {
          "slug": "accent-emerald",
          "color": "#34d399",
          "name": "Accent Emerald"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "figtree",
          "name": "Figtree"
        },
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "inter",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "clamp(0.825rem, 0.825rem + ((1vw - 0.2rem) * 0.488), 1rem)",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "clamp(1rem, 1rem + ((1vw - 0.2rem) * 0.513), 1.25rem)",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "clamp(1.75rem, 1.75rem + ((1vw - 0.2rem) * 0.513), 2.25rem)",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "clamp(2.25rem, 2.25rem + ((1vw - 0.2rem) * 1.5), 3.5rem)",
          "name": "Extra Large"
        }
      ]
    },
    "layout": {
      "contentSize": "840px",
      "wideSize": "1180px"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--secondary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--figtree)",
          "fontWeight": "700"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "link": {
        "color": {
          "text": "inherit"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-cyan)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--background)"
        },
        "border": {
          "radius": "9999px"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  }
}
